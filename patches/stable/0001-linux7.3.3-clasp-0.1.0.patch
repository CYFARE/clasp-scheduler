+static int sched_clasp_update_handler(const struct ctl_table *table,
+		int write, void __user *buffer, size_t *lenp, loff_t *ppos)
+{
+	int ret = proc_dou8vec_minmax(table, write, buffer, lenp, ppos);
+
+	if (ret || !write)
+		return ret;
+
+	if (sched_clasp)
+		static_branch_enable(&sched_clasp_key);
+	else
+		static_branch_disable(&sched_clasp_key);
+
+	return 0;
+}
