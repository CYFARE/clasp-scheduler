diff --git a/kernel/sched/clasp.c b/kernel/sched/clasp.c
new file mode 100644
index 0000000..96fe7e4
--- /dev/null
+++ b/kernel/sched/clasp.c
@@ -0,0 +1,716 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CLASP: Closed-Loop Adaptive Scheduling Policy
+ *
+ * CLASP augments EEVDF with a small per-task control loop:
+ *
+ *   - It observes the actual wake-to-run latency of each task.
+ *   - It compares that latency with a target derived from the task's own
+ *     sleep cadence (frequent short sleepers get tighter targets).
+ *   - It drives a bounded amount of virtual-time credit with an AIMD
+ *     controller and a token bucket, so responsiveness improves without
+ *     permanently changing fair-share weights.
+ *
+ * The scheduler deliberately has no per-tick accounting.  It touches a task
+ * only when the task is placed on a runqueue, first runs after a wake, goes
+ * to sleep, or forks.  This keeps the cost independent of scheduling tick
+ * rate and avoids changing se->load.weight / PELT / h_load.
+ *
+ * Copyright (C) 2026 CLASP authors
+ */
+
+#include <linux/debugfs.h>
+#include <linux/fs.h>
+#include <linux/jump_label.h>
+#include <linux/ktime.h>
+#include <linux/limits.h>
+#include <linux/math64.h>
+#include <linux/minmax.h>
+#include <linux/percpu.h>
+#include <linux/printk.h>
+#include <linux/rcupdate.h>
+#include <linux/sched.h>
+#include <linux/sched/clasp.h>
+#include <linux/seq_file.h>
+#include <linux/sysctl.h>
+#include <linux/time64.h>
+
+#include "sched.h"
+
+#ifdef CONFIG_SCHED_CLASP
+
+#define CLASP_RUN_SHIFT		3	/* 1/8 EWMA of run episode */
+#define CLASP_LAT_SHIFT		2	/* 1/4 EWMA of observed latency */
+#define CLASP_MIN_STEP_NS	50000ULL
+#define CLASP_FORK_STORM_NS	1000000ULL
+
+DEFINE_STATIC_KEY_TRUE(sched_clasp_key);
+
+u8 __read_mostly sched_clasp = 1;
+u8 __read_mostly sched_clasp_preempt = 1;
+
+u32 __read_mostly sched_clasp_target_min_us = 250;
+u32 __read_mostly sched_clasp_target_max_us = 8000;
+u32 __read_mostly sched_clasp_target_shift = 2;
+u32 __read_mostly sched_clasp_boost_max_us = 4000;
+u32 __read_mostly sched_clasp_budget_pct = 100;
+u32 __read_mostly sched_clasp_budget_cap_us = 8000;
+u32 __read_mostly sched_clasp_duty_pct = 80;
+u32 __read_mostly sched_clasp_min_sleep_us = 100;
+u32 __read_mostly sched_clasp_fork_penalty_us = 4000;
+
+static int maxval_1s_us = 1000000;
+static int maxval_100 = 100;
+static int maxval_8 = 8;
+
+struct clasp_pcpu_stats {
+	u64 wakeups;
+	u64 boosted;
+	u64 misses;
+	u64 credit_ns;
+	u64 lat_sum_ns;
+	u64 lat_max_ns;
+	u64 boost_sum_ns;
+	u64 preempt_try;
+	u64 preempt_ok;
+	u64 ineligible;
+};
+
+static DEFINE_PER_CPU(struct clasp_pcpu_stats, clasp_stats);
+
+static inline u32 clasp_ns_to_u32(u64 ns)
+{
+	return ns > U32_MAX ? U32_MAX : (u32)ns;
+}
+
+/*
+ * Integer EWMA that does not overflow and moves both up and down.  shift=0
+ * degenerates to "use the newest sample".
+ */
+static inline u32 clasp_ewma(u32 old, u32 new, unsigned int shift)
+{
+	if (!shift)
+		return new;
+	if (new >= old)
+		return old + ((new - old) >> shift);
+	return old - ((old - new) >> shift);
+}
+
+static inline u32 clasp_boost_max_ns(void)
+{
+	return clasp_ns_to_u32((u64)sched_clasp_boost_max_us *
+			       NSEC_PER_USEC);
+}
+
+static inline u32 clasp_budget_cap_ns(void)
+{
+	return clasp_ns_to_u32((u64)sched_clasp_budget_cap_us *
+			       NSEC_PER_USEC);
+}
+
+static u32 clasp_target_ns(const struct clasp_ctx *c)
+{
+	u64 min_ns = (u64)sched_clasp_target_min_us * NSEC_PER_USEC;
+	u64 max_ns = (u64)sched_clasp_target_max_us * NSEC_PER_USEC;
+	unsigned int shift = min_t(u32, sched_clasp_target_shift, 8);
+	u64 target;
+
+	if (max_ns < min_ns)
+		max_ns = min_ns;
+
+	target = (u64)c->sleep_avg >> shift;
+	target = clamp(target, min_ns, max_ns);
+
+	return clasp_ns_to_u32(target);
+}
+
+/*
+ * Convert the task's negative EEVDF lag (virtual time) into nanoseconds of
+ * CPU time.  An urgent waker that is ineligible because it is ahead of the
+ * runqueue's virtual time cannot be picked at all; giving it at least this
+ * much credit makes the virtual-time comparison meaningful again.  The
+ * token bucket still bounds how much of this repair can be granted.
+ */
+static u32 clasp_debt_ns(struct sched_entity *se)
+{
+	s64 vlag = READ_ONCE(se->vlag);
+	unsigned long weight;
+	u64 v, ns;
+
+	if (vlag >= 0)
+		return 0;
+
+	weight = READ_ONCE(se->h_load.weight);
+	if (!weight)
+		weight = NICE_0_LOAD;
+
+	v = (u64)(-(vlag + 1)) + 1;
+	v = min(v, 1000000000000ULL);
+	ns = div64_u64(v * weight, NICE_0_LOAD);
+
+	return clasp_ns_to_u32(ns);
+}
+
+/*
+ * The token bucket earns extra CPU-time credit in proportion to wall time
+ * elapsed since the last wake.  A task that sleeps half of the time can
+ * therefore obtain at most budget_pct of its sleep time as extra CPU, and
+ * the absolute amount is capped by budget_cap_us.
+ */
+static void clasp_refill_budget(struct clasp_ctx *c, u64 now)
+{
+	u64 elapsed, cap, refill;
+
+	if (!c->last_budget) {
+		c->last_budget = now;
+		return;
+	}
+
+	elapsed = now > c->last_budget ? now - c->last_budget : 0;
+	c->last_budget = now;
+	if (!elapsed)
+		return;
+
+	cap = (u64)sched_clasp_budget_cap_us * NSEC_PER_USEC;
+	if (elapsed > cap)
+		elapsed = cap;		/* pct is bounded by 100 */
+
+	refill = div64_u64(elapsed * (u64)sched_clasp_budget_pct, 100);
+	refill = min(refill, cap);
+	c->budget = (u32)min_t(u64, cap, (u64)c->budget + refill);
+}
+
+static void clasp_update_parent(struct task_struct *p)
+{
+	struct task_struct *parent;
+	u32 avg;
+
+	if (p->clasp.flags & CLASP_F_PARENT_UPDATED)
+		return;
+
+	/* Only process leaders represent fork-heavy work; threads do not. */
+	if (p->tgid != p->pid)
+		return;
+
+	rcu_read_lock();
+	parent = rcu_dereference(p->real_parent);
+	if (parent && parent != p) {
+		avg = clasp_ewma(READ_ONCE(parent->clasp.child_run_avg),
+				 p->clasp.run_avg, 2);
+		WRITE_ONCE(parent->clasp.child_run_avg, avg);
+		p->clasp.flags |= CLASP_F_PARENT_UPDATED;
+	}
+	rcu_read_unlock();
+}
+
+/*
+ * Called from place_entity() before enqueue.  Returns a virtual-time credit
+ * in nanoseconds of CPU time; fair.c converts it with calc_delta_fair().
+ */
+u32 clasp_prepare_wake(struct task_struct *p, struct sched_entity *se, u64 now)
+{
+	struct clasp_ctx *c = &p->clasp;
+	u32 target, bmax, desired, headroom, credit = 0;
+	u64 exec, ran;
+	bool allowed;
+
+	if (unlikely(!(c->flags & CLASP_F_VALID)))
+		return 0;
+
+	/* Latency hints are only meaningful for ordinary fair tasks. */
+	if (p->policy != SCHED_NORMAL)
+		return 0;
+
+	if (c->flags & CLASP_F_SLEEPING) {
+		u64 slept = 0;
+
+		if (c->sleep_start)
+			slept = now > c->sleep_start ?
+				now - c->sleep_start : 0;
+
+		/*
+		 * Adapt downward immediately: a process that slept for seconds
+		 * while starting up must not keep an 8 ms latency target after it
+		 * switches to a 1 ms or 16 ms cadence.  Upward changes are smoothed
+		 * so a single long sleep does not desensitize the task.
+		 */
+		if (slept && slept < c->sleep_avg)
+			c->sleep_avg = clasp_ns_to_u32(slept);
+		else
+			c->sleep_avg = clasp_ewma(c->sleep_avg,
+						  clasp_ns_to_u32(slept), 1);
+		c->sleep_start = 0;
+		c->flags &= ~CLASP_F_SLEEPING;
+	}
+
+	clasp_refill_budget(c, now);
+
+	exec = se->sum_exec_runtime;
+	ran = exec > c->last_exec ? exec - c->last_exec : 0;
+	c->last_exec = exec;
+	if (ran >= c->credit_outstanding)
+		c->credit_outstanding = 0;
+	else
+		c->credit_outstanding -= (u32)ran;
+
+	/* One CPU-time episode begins at the first wake and ends at sleep. */
+	if (!(c->flags & CLASP_F_EPISODE)) {
+		c->episode_exec = exec;
+		c->flags |= CLASP_F_EPISODE;
+	}
+
+	/* Keep the oldest outstanding wake time for a spurious wakeup. */
+	if (!c->wait_start)
+		c->wait_start = now ? now : 1;
+
+	target = clasp_target_ns(c);
+
+	allowed = !(c->flags & (CLASP_F_FORK_HEAVY | CLASP_F_PROBATION));
+	if ((u64)c->run_avg * 100 >=
+	    (u64)sched_clasp_duty_pct * ((u64)c->run_avg + c->sleep_avg))
+		allowed = false;
+
+	/*
+	 * Sub-100us IPC ping-pong is already handled by EEVDF's normal
+	 * wakeup preemption; forcing it only adds context-switch overhead.
+	 * CLASP targets human-visible cadences (audio, input, frames).
+	 */
+	if ((u64)c->sleep_avg <
+	    (u64)sched_clasp_min_sleep_us * NSEC_PER_USEC)
+		allowed = false;
+
+	/* A small latency floor for proven low-duty sleepers. */
+	if (allowed && c->boost < (target >> 1))
+		c->boost = target >> 1;
+
+	bmax = clasp_boost_max_ns();
+	if (c->boost > bmax)
+		c->boost = bmax;
+
+	desired = max(c->boost, clasp_debt_ns(se));
+	desired = min(desired, c->budget);
+	headroom = bmax > c->credit_outstanding ?
+		bmax - c->credit_outstanding : 0;
+	credit = min(desired, headroom);
+	if (!allowed)
+		credit = 0;
+
+	if (credit) {
+		c->budget -= credit;
+		c->credit_outstanding += credit;
+	}
+
+	c->flags &= ~CLASP_F_PREEMPT;
+	if (credit && ((c->flags & CLASP_F_URGENT) ||
+		       c->lat_avg > target || c->lat_last > target ||
+		       now < c->hold_until))
+		c->flags |= CLASP_F_PREEMPT;
+
+	this_cpu_inc(clasp_stats.wakeups);
+	this_cpu_add(clasp_stats.boost_sum_ns, c->boost);
+	if (se->vlag < 0)
+		this_cpu_inc(clasp_stats.ineligible);
+	if (credit) {
+		this_cpu_inc(clasp_stats.boosted);
+		this_cpu_add(clasp_stats.credit_ns, credit);
+	}
+
+	return credit;
+}
+
+/*
+ * Called from set_next_entity() when the task is about to run.  Consumes
+ * the wake timestamp (closing the latency control loop), updates the AIMD
+ * boost, and starts a CPU-time episode if the task did not wake.
+ */
+void clasp_task_start(struct task_struct *p, struct sched_entity *se, u64 now)
+{
+	struct clasp_ctx *c = &p->clasp;
+	u32 target, bmax, step, lat = 0;
+
+	if (unlikely(!(c->flags & CLASP_F_VALID)))
+		return;
+
+	if (c->wait_start) {
+		u64 delta = now > c->wait_start ? now - c->wait_start : 0;
+
+		lat = clasp_ns_to_u32(delta);
+		c->lat_last = lat;
+		c->lat_avg = clasp_ewma(c->lat_avg, lat, CLASP_LAT_SHIFT);
+		c->wait_start = 0;
+
+		target = clasp_target_ns(c);
+		bmax = clasp_boost_max_ns();
+
+		if (lat > target || c->lat_avg > target) {
+			u64 hold;
+
+			step = max_t(u32, target, (u32)CLASP_MIN_STEP_NS);
+			c->boost = min(bmax, c->boost + step);
+			c->flags |= CLASP_F_URGENT;
+			this_cpu_inc(clasp_stats.misses);
+
+			hold = (u64)c->sleep_avg * 8;
+			if (hold < 10 * NSEC_PER_MSEC)
+				hold = 10 * NSEC_PER_MSEC;
+			if (hold > 50 * NSEC_PER_MSEC)
+				hold = 50 * NSEC_PER_MSEC;
+			c->hold_until = now + hold;
+		} else if (now > c->hold_until &&
+			   (u64)lat * 4 < (u64)target * 3 &&
+			   (u64)c->lat_avg * 4 < (u64)target * 3) {
+			c->boost -= c->boost >> 4;
+			if (c->boost < CLASP_MIN_STEP_NS)
+				c->boost = 0;
+		}
+
+		this_cpu_add(clasp_stats.lat_sum_ns, lat);
+		if (lat > this_cpu_read(clasp_stats.lat_max_ns))
+			this_cpu_write(clasp_stats.lat_max_ns, lat);
+	}
+
+	if (!(c->flags & CLASP_F_EPISODE)) {
+		c->episode_exec = se->sum_exec_runtime;
+		c->flags |= CLASP_F_EPISODE;
+	}
+
+	c->flags &= ~CLASP_F_PREEMPT;
+}
+
+/*
+ * Called on voluntary dequeue.  sum_exec_runtime has already been updated
+ * by update_curr(), so the delta from the wake point is the total CPU time
+ * the task consumed in this episode (including any preemptions).
+ */
+void clasp_task_sleep(struct task_struct *p, struct sched_entity *se, u64 now)
+{
+	struct clasp_ctx *c = &p->clasp;
+	u64 run_len;
+
+	if (unlikely(!(c->flags & CLASP_F_VALID)))
+		return;
+
+	if (c->flags & CLASP_F_EPISODE) {
+		run_len = se->sum_exec_runtime > c->episode_exec ?
+			se->sum_exec_runtime - c->episode_exec : 0;
+		c->run_avg = clasp_ewma(c->run_avg,
+					clasp_ns_to_u32(run_len),
+					CLASP_RUN_SHIFT);
+		c->flags &= ~CLASP_F_EPISODE;
+	}
+
+	/* A voluntary sleep is proof that this task can be a real sleeper. */
+	c->flags &= ~(CLASP_F_PREEMPT | CLASP_F_PROBATION);
+	c->wait_start = 0;
+	c->sleep_start = now ? now : 1;
+	c->flags |= CLASP_F_SLEEPING;
+
+	clasp_update_parent(p);
+}
+
+/*
+ * O(1) fork inheritance.  There are no ancestor or child-list walks:
+ *   - a thread inherits its process's current control state;
+ *   - a fork inherits the parent's own run/sleep profile plus the parent's
+ *     learned child profile (a one-word EWMA);
+ *   - a fork storm or a batch-lineage parent marks the child as heavy and
+ *     puts it on probation until its first voluntary sleep.
+ */
+void clasp_task_fork(struct task_struct *p, struct task_struct *parent)
+{
+	struct clasp_ctx *c = &p->clasp;
+	struct clasp_ctx *pc = &parent->clasp;
+	u32 bmax = clasp_boost_max_ns();
+	u32 cap = clasp_budget_cap_ns();
+	u64 now, delta, penalty;
+	bool thread = same_thread_group(p, parent);
+	bool heavy;
+
+	c->flags = CLASP_F_VALID;
+	c->wait_start = 0;
+	c->sleep_start = 0;
+	c->episode_exec = 0;
+	c->last_exec = p->se.sum_exec_runtime;
+	c->last_budget = 0;
+	c->last_fork = 0;
+	c->hold_until = 0;
+	c->lat_last = 0;
+	c->credit_outstanding = 0;
+	c->child_run_avg = 0;
+	c->fork_burst = 0;
+
+	if (thread) {
+		/* Threads of one process share its latency profile. */
+		c->run_avg = pc->run_avg;
+		c->sleep_avg = pc->sleep_avg;
+		c->lat_avg = pc->lat_avg;
+		c->boost = min(pc->boost, bmax);
+		c->budget = min(pc->budget, cap);
+		if (pc->flags & CLASP_F_URGENT)
+			c->flags |= CLASP_F_URGENT;
+		if (!c->budget)
+			c->budget = min(bmax / 2, cap);
+		return;
+	}
+
+	now = ktime_get_ns();
+	delta = now > pc->last_fork ? now - pc->last_fork : 0;
+	pc->last_fork = now;
+
+	if (delta && delta < CLASP_FORK_STORM_NS) {
+		if (pc->fork_burst < U8_MAX)
+			pc->fork_burst++;
+	} else {
+		pc->fork_burst = 0;
+	}
+
+	heavy = pc->fork_burst >= 3 ||
+		(pc->flags & CLASP_F_FORK_HEAVY);
+
+	c->run_avg = max3(pc->run_avg,
+			  READ_ONCE(pc->child_run_avg),
+			  c->run_avg);
+	/* Do not inherit a long shell/daemon sleep cadence. */
+	c->sleep_avg = 0;
+	c->lat_avg = heavy ? 0 : pc->lat_avg;
+	c->boost = heavy ? 0 : min(pc->boost, bmax);
+	c->budget = heavy ? 0 : min(pc->budget, bmax / 2);
+	if (!heavy && !c->budget)
+		c->budget = min(bmax / 2, cap);
+
+	if (heavy) {
+		penalty = (u64)sched_clasp_fork_penalty_us * NSEC_PER_USEC;
+		c->run_avg = max_t(u32, c->run_avg,
+				   clasp_ns_to_u32(penalty));
+		c->flags |= CLASP_F_FORK_HEAVY | CLASP_F_PROBATION;
+	}
+}
+
+void clasp_task_dead(struct task_struct *p)
+{
+	if (unlikely(!(p->clasp.flags & CLASP_F_VALID)))
+		return;
+
+	clasp_update_parent(p);
+}
+
+void clasp_note_preempt(bool eligible)
+{
+	this_cpu_inc(clasp_stats.preempt_try);
+	if (eligible)
+		this_cpu_inc(clasp_stats.preempt_ok);
+}
