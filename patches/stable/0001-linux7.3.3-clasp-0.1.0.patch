+void __init sched_init_clasp(void)
+{
+	pr_info("CLASP: Closed-Loop Adaptive Scheduling Policy\n");
+
+	memset(&init_task.clasp, 0, sizeof(init_task.clasp));
+	init_task.clasp.flags = CLASP_F_VALID;
+
+	if (!sched_clasp)
+		static_branch_disable(&sched_clasp_key);
+}
