diff --git a/include/linux/sched.h b/include/linux/sched.h
index 78bfc0e..1de7371 100644
--- a/include/linux/sched.h
+++ b/include/linux/sched.h
@@ -832,6 +832,36 @@ struct task_ipi_mask {
 struct task_ipi_mask { };
 #endif
 
+#ifdef CONFIG_SCHED_CLASP
+/*
+ * CLASP (Closed-Loop Adaptive Scheduling Policy) per-task state.
+ *
+ * All times are nanoseconds.  The context is intentionally small and lives
+ * in task_struct so that wakeup and sleep paths never allocate or take a
+ * remote cache line just to read scheduling history.
+ */
+struct clasp_ctx {
+	u64	wait_start;		/* rq clock at wake enqueue */
+	u64	sleep_start;		/* rq clock at voluntary sleep */
+	u64	episode_exec;		/* sum_exec_runtime at wake */
+	u64	last_exec;		/* sum_exec_runtime at last wake */
+	u64	last_budget;		/* rq clock of last budget refill */
+	u64	last_fork;		/* parent fork timestamp */
+	u64	hold_until;		/* keep boost active until this time */
+	u32	run_avg;		/* EWMA of CPU ns per wake episode */
+	u32	sleep_avg;		/* EWMA of voluntary sleep ns */
+	u32	lat_avg;		/* EWMA of observed wake-to-run latency */
+	u32	lat_last;		/* last observed wake-to-run latency */
+	u32	boost;			/* desired credit per wake, ns */
+	u32	budget;			/* token bucket for extra CPU time, ns */
+	u32	credit_outstanding;	/* granted but not yet consumed, ns */
+	u32	child_run_avg;		/* EWMA of children's run_avg */
+	u8	flags;
+	u8	fork_burst;
+	u8	pad[2];
+};
+#endif /* CONFIG_SCHED_CLASP */
+
 struct task_struct {
 #ifdef CONFIG_THREAD_INFO_IN_TASK
 	/*
@@ -890,6 +920,9 @@ struct task_struct {
 	struct sched_rt_entity		rt;
 	struct sched_dl_entity		dl;
 	struct sched_dl_entity		*dl_server;
+#ifdef CONFIG_SCHED_CLASP
+	struct clasp_ctx		clasp;
+#endif
 #ifdef CONFIG_SCHED_CLASS_EXT
 	struct sched_ext_entity		scx;
 #endif
diff --git a/include/linux/sched/clasp.h b/include/linux/sched/clasp.h
new file mode 100644
index 0000000..f6ee0a0
--- /dev/null
+++ b/include/linux/sched/clasp.h
@@ -0,0 +1,61 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_SCHED_CLASP_H
+#define _LINUX_SCHED_CLASP_H
+
+#include <linux/bits.h>
+#include <linux/jump_label.h>
+#include <linux/types.h>
+
+struct task_struct;
+struct sched_entity;
+
+#ifdef CONFIG_SCHED_CLASP
+
+/*
+ * Per-task state flags.  These live in struct clasp_ctx::flags, which is
+ * part of task_struct and is therefore only touched while the task's rq
+ * lock (or the task itself during fork) is held.
+ */
+#define CLASP_F_VALID		BIT(0)
+#define CLASP_F_SLEEPING	BIT(1)
+#define CLASP_F_EPISODE		BIT(2)
+#define CLASP_F_PREEMPT		BIT(3)
+#define CLASP_F_FORK_HEAVY	BIT(4)
+#define CLASP_F_PROBATION	BIT(5)
+#define CLASP_F_PARENT_UPDATED	BIT(6)
+#define CLASP_F_URGENT		BIT(7)
+
+extern u8 sched_clasp;
+extern u8 sched_clasp_preempt;
+DECLARE_STATIC_KEY_TRUE(sched_clasp_key);
+
+u32 clasp_prepare_wake(struct task_struct *p, struct sched_entity *se,
+		       u64 now);
+void clasp_task_start(struct task_struct *p, struct sched_entity *se, u64 now);
+void clasp_task_sleep(struct task_struct *p, struct sched_entity *se, u64 now);
+void clasp_task_fork(struct task_struct *p, struct task_struct *parent);
+void clasp_task_dead(struct task_struct *p);
+void clasp_note_preempt(bool eligible);
+void sched_init_clasp(void);
+
+#else /* !CONFIG_SCHED_CLASP */
+
+static inline u32 clasp_prepare_wake(struct task_struct *p,
+				     struct sched_entity *se, u64 now)
+{
+	return 0;
+}
+
+static inline void clasp_task_start(struct task_struct *p,
+				    struct sched_entity *se, u64 now) { }
+static inline void clasp_task_sleep(struct task_struct *p,
+				    struct sched_entity *se, u64 now) { }
+static inline void clasp_task_fork(struct task_struct *p,
+				   struct task_struct *parent) { }
+static inline void clasp_task_dead(struct task_struct *p) { }
+static inline void clasp_note_preempt(bool eligible) { }
+static inline void sched_init_clasp(void) { }
+
+#endif /* CONFIG_SCHED_CLASP */
+
+#endif /* _LINUX_SCHED_CLASP_H */
diff --git a/init/Kconfig b/init/Kconfig
index ad592fd..29a01d3 100644
--- a/init/Kconfig
+++ b/init/Kconfig
@@ -1494,6 +1494,24 @@ config CHECKPOINT_RESTORE
 
 	  If unsure, say N here.
 
+config SCHED_CLASP
+	bool "Closed-Loop Adaptive Scheduling Policy"
+	default y
+	help
+	  CLASP augments EEVDF with a bounded latency control loop.  It
+	  measures each task's actual wake-to-run delay, compares it with a
+	  target derived from that task's sleep cadence, and grants a limited
+	  amount of virtual-time credit when the target is missed.  Extra CPU
+	  time is rate-limited by a token bucket, so fairness and throughput
+	  are not permanently displaced by interactive tasks.
+
+	  Unlike burst-time based schedulers, CLASP performs no per-tick
+	  accounting and never modifies task weights, PELT averages, or
+	  hierarchical load.  It is a research feature: benchmark it for your
+	  workload before enabling it in production.
+
+	  If unsure, say Y here.
+
 config SCHED_AUTOGROUP
 	bool "Automatic process group scheduling"
 	select CGROUPS
