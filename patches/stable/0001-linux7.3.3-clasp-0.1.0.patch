+#ifdef CONFIG_DEBUG_FS
+static int clasp_stats_show(struct seq_file *m, void *v)
+{
+	u64 wakeups = 0, boosted = 0, misses = 0, credit_ns = 0;
+	u64 lat_sum_ns = 0, lat_max_ns = 0, boost_sum_ns = 0;
+	u64 preempt_try = 0, preempt_ok = 0, ineligible = 0;
+	int cpu;
+
+	seq_puts(m, "cpu wakeups boosted misses credit_ns lat_sum_ns lat_max_ns boost_sum_ns preempt_try preempt_ok ineligible\n");
+
+	for_each_possible_cpu(cpu) {
+		struct clasp_pcpu_stats *s = per_cpu_ptr(&clasp_stats, cpu);
+
+		seq_printf(m, "%d %llu %llu %llu %llu %llu %llu %llu %llu %llu %llu\n",
+			   cpu,
+			   (unsigned long long)s->wakeups,
+			   (unsigned long long)s->boosted,
+			   (unsigned long long)s->misses,
+			   (unsigned long long)s->credit_ns,
+			   (unsigned long long)s->lat_sum_ns,
+			   (unsigned long long)s->lat_max_ns,
+			   (unsigned long long)s->boost_sum_ns,
+			   (unsigned long long)s->preempt_try,
+			   (unsigned long long)s->preempt_ok,
+			   (unsigned long long)s->ineligible);
+
+		wakeups += s->wakeups;
+		boosted += s->boosted;
+		misses += s->misses;
+		credit_ns += s->credit_ns;
+		lat_sum_ns += s->lat_sum_ns;
+		lat_max_ns = max(lat_max_ns, s->lat_max_ns);
+		boost_sum_ns += s->boost_sum_ns;
+		preempt_try += s->preempt_try;
+		preempt_ok += s->preempt_ok;
+		ineligible += s->ineligible;
+	}
+
+	seq_printf(m, "total %llu %llu %llu %llu %llu %llu %llu %llu %llu %llu\n",
+		   (unsigned long long)wakeups,
+		   (unsigned long long)boosted,
+		   (unsigned long long)misses,
+		   (unsigned long long)credit_ns,
+		   (unsigned long long)lat_sum_ns,
+		   (unsigned long long)lat_max_ns,
+		   (unsigned long long)boost_sum_ns,
+		   (unsigned long long)preempt_try,
+		   (unsigned long long)preempt_ok,
+		   (unsigned long long)ineligible);
+
+	return 0;
+}
+
+static int clasp_stats_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, clasp_stats_show, NULL);
+}
+
+static const struct file_operations clasp_stats_fops = {
